<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the log that the user chooses to share (see AppLog.share) -->
    <cache-path name="shared" path="shared/" />
    <!-- Attachments downloaded to be opened or shared (see MailRepository.attachmentFile) -->
    <cache-path name="attachments" path="attachments/" />
    <!-- The APK of a newer Cemail, for Android's installer (see Updates.install) -->
    <files-path name="updates" path="updates/" />
</paths>
